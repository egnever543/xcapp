# Configurações do site (defina estas variáveis na Vercel ou em .env.local)

# Webhook do chatbot que recebe o lead e devolve a Pay URL.
# Se não definida, usa o endpoint padrão embutido no código.
CHATBOT_URL=https://sistema.ftspanel.vip/api/chatbot/nVrW8roLKa/RYAWRk1jlx

# ID do Google Ads (gtag.js), formato AW-XXXXXXXXX.
# Se não definida, o pixel não é injetado.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Número do WhatsApp para o botão "Comprar pelo WhatsApp".
# Use DDI + DDD + número, só dígitos (ex.: 5511999999999).
# Se não definida, o botão não aparece.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Host do servidor Xtream Codes (para consultar o vencimento via player_api.php).
# Inclua protocolo e porta. Ex.: http://SEU_HOST:80
# Também é usado como URL de acesso no e-mail enviado ao cliente.
# Se não definida, a rota /api/xtream não consulta e o vencimento não é exibido.
XTREAM_HOST=http://SEU_HOST:80

# Envio de e-mail via Resend (dados de acesso quando a conta vira paga).
# RESEND_API_KEY: sua chave da API do Resend.
# EMAIL_FROM: remetente verificado no Resend. Ex.: "xciptv <no-reply@seudominio.com>"
# Sem estas variáveis, o e-mail não é enviado.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=xciptv <no-reply@seudominio.com>

# Pagamento PIX via FastDePix.
# FASTDEPIX_API_KEY: chave da API (formato fdpx_...). O provedor (fastpay/
#   fastflow/depix) é definido pelo tipo da chave no painel.
# FASTDEPIX_BASE_URL (opcional): padrão https://fastdepix.space/api/v1
# FASTDEPIX_WEBHOOK_SECRET (opcional): valida a assinatura dos webhooks.
FASTDEPIX_API_KEY=fdpx_xxxxxxxxxxxxxxxxxxxx
FASTDEPIX_BASE_URL=https://fastdepix.space/api/v1
FASTDEPIX_WEBHOOK_SECRET=

# Painel Sigma (FTS Panel) — criação automática do cliente após o pagamento.
# SIGMA_API_TOKEN: token Bearer da integração (Settings -> Developers).
# SIGMA_BASE_URL (opcional): padrão https://sistema.ftspanel.vip/api/integration/v1
# SIGMA_OWNER_ID (opcional): userId (hashid) dono das contas criadas.
# Os packageId de cada pacote ficam fixos no código (src/lib/packages.ts).
SIGMA_API_TOKEN=
SIGMA_BASE_URL=https://sistema.ftspanel.vip/api/integration/v1
SIGMA_OWNER_ID=

# Painel admin (/admin) — Basic Auth. Sem estas variáveis, o /admin fica bloqueado.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Banco de dados (Neon/Postgres) — histórico de compras e reenvio de e-mail.
# Injetado automaticamente pela integração Neon na Vercel (DATABASE_URL).
DATABASE_URL=
